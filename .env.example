# ADMIN_TOKEN: chi la cong thoat khan cap (break-glass), KHONG dat gia tri mac dinh de trong repo.
# Chi tao khi that su can, dat 1 chuoi ngau nhien dai tren Vercel, khong commit gia tri that vao git.
ADMIN_TOKEN=
# Telegram bot dùng chung cho: webhook đơn hàng mới + thông báo lead báo giá từ website.
# Token lấy từ @BotFather, chat_id lấy bằng cách gửi tin nhắn cho bot rồi gọi getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_PRODUCTS_URL=
SUPABASE_PRODUCTS_ANON_KEY=
SUPABASE_PRODUCTS_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CUSTOMER_SESSION_SECRET=
# Web Push (thông báo đẩy cho order-webapp + sale-webapp) — sinh 1 lần bằng
# `npx web-push generate-vapid-keys`, dùng chung cho cả 2 chiều (khách + sale).
# VAPID_SUBJECT phải là "mailto:..." hoặc URL https, theo chuẩn Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@thucphamsomot.vn
