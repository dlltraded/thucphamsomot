{
  "name": "zmp-cli-core",
  "version": "1.1.3",
  "description": "Common logic for all DevTools (ZMP CLI, Zalo Mini App Extension).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs",
    "watch": "ENABLE_SOURCE_MAP=1 NO_OBFUSCATE=1 NO_DTS=1 rollup -c rollup.config.mjs --watch",
    "package": "npm run build && npm pack"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/dom-parser": "^0.1.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/localtunnel": "^2.0.2",
    "@types/node": "^16",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^7.19.0",
    "prettier": "^2.2.1",
    "rollup": "^4.16.3",
    "rollup-obfuscator": "^4.1.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "dom-parser": "^0.1.6",
    "download-git-repo": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "localtunnel": "^2.0.2",
    "zip-local": "^0.3.5"
  }
}
